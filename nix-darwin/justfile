hostname := `scutil --get LocalHostName | tr '[:upper:]' '[:lower:]'`
darwin-rebuild := "/run/current-system/sw/bin/darwin-rebuild"
tracked-flake-inputs := "codex-cli-nix claude-code-nix git-sync-rs keepbook git-blame-rank lastfm-edit gmcli homebrew-core homebrew-cask"

build:
    {{ darwin-rebuild }} build --flake .#{{ hostname }}

# Activate inside the primary user's launchd session so user agents load
# even when switching over SSH.
switch:
    primary_user="$(nix eval --raw .#darwinConfigurations.{{ hostname }}.config.system.primaryUser)" && \
    sudo launchctl asuser "$(id -u "$primary_user")" env HOME=/var/root {{ darwin-rebuild }} switch --flake .#{{ hostname }}

update:
    /run/current-system/sw/bin/nix flake update
    just switch

bump-tracked-flakes:
    /run/current-system/sw/bin/nix flake update {{ tracked-flake-inputs }}
    just switch

update-nix-darwin:
    nix flake lock --update-input nix-darwin
