hostname := `scutil --get LocalHostName | tr '[:upper:]' '[:lower:]'`
darwin-rebuild := "/run/current-system/sw/bin/darwin-rebuild"
tracked-flake-inputs := "codex-cli-nix claude-code-nix git-sync-rs keepbook git-blame-rank lastfm-edit gmcli homebrew-core homebrew-cask"

build:
    {{ darwin-rebuild }} build --flake .#{{ hostname }}

# Build as the invoking user, since root's Nix refuses a checkout it does not
# own, then do what `darwin-rebuild switch` does after building. Activate
# inside the primary user's launchd session so user agents load even when
# switching over SSH.
switch:
    system="$(nix build --no-link --print-out-paths .#darwinConfigurations.{{ hostname }}.system)" && \
    primary_user="$(nix eval --raw .#darwinConfigurations.{{ hostname }}.config.system.primaryUser)" && \
    sudo "$(command -v nix-env)" -p /nix/var/nix/profiles/system --set "$system" && \
    sudo launchctl asuser "$(id -u "$primary_user")" env HOME=/var/root "$system/activate"

update:
    nix flake update
    just switch

bump-tracked-flakes:
    nix flake update {{ tracked-flake-inputs }}
    just switch

update-nix-darwin:
    nix flake lock --update-input nix-darwin
