hostname := "mac-demarco-mini"
darwin-rebuild := "/run/current-system/sw/bin/darwin-rebuild"
ssh-key := "/Users/kat/.ssh/id_ed25519"

build:
    sudo -H env "GIT_SSH_COMMAND=ssh -i {{ ssh-key }} -o IdentitiesOnly=yes" {{ darwin-rebuild }} build --flake .#{{ hostname }}

switch:
    sudo launchctl asuser "$(id -u kat)" env HOME=/var/root "GIT_SSH_COMMAND=ssh -i {{ ssh-key }} -o IdentitiesOnly=yes" {{ darwin-rebuild }} switch --flake .#{{ hostname }}

build-air:
    {{ darwin-rebuild }} build --flake .#alexanders-macbook-air

switch-air:
    sudo -H {{ darwin-rebuild }} switch --flake .#alexanders-macbook-air

update:
    /run/current-system/sw/bin/nix flake update
    just switch

update-nix-darwin:
    nix flake lock --update-input nix-darwin
