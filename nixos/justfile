tracked-flake-inputs := "computer-use-linux cua-driver codex-cli-nix codex-desktop-linux claude-code-nix claude-desktop git-sync-rs keepbook rynkbench git-blame-rank org-agenda-api lastfm-edit gmcli voxtype rlru kanshi-sni chrome-favicon-dbus notifications-tray-icon heroic-games-launcher nixified-ai gocryptfs-tray"
