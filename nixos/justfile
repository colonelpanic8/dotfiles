switch *args:
	dotfiles_worktree="$(/run/current-system/sw/bin/readlink -f "$PWD/..")"; if [ "$dotfiles_worktree" != /srv/dotfiles ]; then echo "Refusing to activate dotfiles from non-primary checkout: $dotfiles_worktree" >&2; exit 1; fi; case "$(/run/current-system/sw/bin/systemctl show -P ActiveState nixos-upgrade.service 2>/dev/null)" in active|activating|reloading) /run/wrappers/bin/sudo /run/current-system/sw/bin/systemctl stop nixos-upgrade.service;; esac; peer_substituters="$(echo $(/run/current-system/sw/bin/nix-peer-cache urls 2>/dev/null))"; /run/wrappers/bin/sudo env DOTFILES_WORKTREE="$dotfiles_worktree" PATH=/run/current-system/sw/bin:/nix/var/nix/profiles/system/sw/bin:/etc/profiles/per-user/root/bin:/usr/bin:/bin /run/current-system/sw/bin/nixos-rebuild switch --flake ".#" --impure --option substituters "$peer_substituters {{switch-substituters}}" --option trusted-public-keys '{{switch-trusted-public-keys}}' --option connect-timeout 3 --option fallback true --option download-attempts 2 {{args}}

# Show the latest activation, which outlives the caller that started it.
switch-log lines="80":
	/run/current-system/sw/bin/journalctl -b --no-pager -n {{lines}} -u nixos-rebuild-switch-to-configuration

bump-tracked-flakes *args:
	github_token="$(gh auth token 2>/dev/null)"; PATH=/run/current-system/sw/bin:/nix/var/nix/profiles/system/sw/bin:/etc/profiles/per-user/root/bin:/usr/bin:/bin nix flake update ${github_token:+--option access-tokens "github.com=$github_token"} {{tracked-flake-inputs}}
	just switch {{args}}

# Commit/tag-pinned inputs remain fixed until their flake URLs are changed.
bump-hyprland *args:
	github_token="$(gh auth token 2>/dev/null)"; PATH=/run/current-system/sw/bin:/nix/var/nix/profiles/system/sw/bin:/etc/profiles/per-user/root/bin:/usr/bin:/bin nix flake update ${github_token:+--option access-tokens "github.com=$github_token"} {{hyprland-flake-inputs}}
	just switch {{args}}

populate-cachix cache="colonelpanic8-dotfiles" host=`hostname` *args:
	store_path="$(nix build --no-link --print-out-paths ".#nixosConfigurations.{{host}}.config.system.build.toplevel" --impure --option warn-dirty false {{args}})" && cachix push {{cache}} "$store_path"

publish-hyprland-cachix cache="colonelpanic8-dotfiles" *args:
	store_paths="$(nix build --no-link --print-out-paths ".#hyprland-stuff" --option warn-dirty false {{args}})" && cachix push {{cache}} $store_paths

# Build a sideloadable Android APK from the pinned T3 Code integration source.
t3code-apk *args:
	nix run .#t3code-apk -- {{args}}

# Family installer commands use its independent stable flake.
family-check:
    cd family-installer && nix develop --command just check
    nix flake check ./family-installer

family-iso:
    nix build ./family-installer#iso --out-link result-family

family-usb *args:
    cd family-installer && nix develop --command just prepare {{args}}

rescue-iso:
    nix build .#nixosConfigurations.rescue.config.system.build.isoImage --out-link result-rescue

rescue-usb-build:
    nix build .#nixosConfigurations.rescue-usb.config.system.build.toplevel --out-link result-rescue-usb
