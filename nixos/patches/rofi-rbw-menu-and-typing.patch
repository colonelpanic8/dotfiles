+    def __show_action_menu(self, entry: DetailedEntry) -> tuple[list[Target], Action | None]:
+        has_totp = isinstance(entry, Credentials) and entry.has_totp
+        choices = [
+            keybinding
+            for keybinding in self.args.parsed_keybindings
+            if keybinding.action not in (None, Action.SYNC)
+            and keybinding.targets
+            and Targets.MENU not in keybinding.targets
+            and (has_totp or Targets.TOTP not in keybinding.targets)
+        ]
+        labels = [
+            f"{self.selector._format_action_and_targets(keybinding)}  <i>{keybinding.shortcut}</i>"
+            for keybinding in choices
+        ]
+        labels.append("Choose field…")
+        result = run(
+            ["rofi", "-dmenu", "-markup-rows", "-i", "-format", "i", "-p", entry.name, *self.args.selector_args],
+            input="\n".join(labels),
+            capture_output=True,
+            encoding="utf-8",
+        )
+        if result.returncode != 0 or not result.stdout.strip():
+            self.main()
+            exit(0)
+        index = int(result.stdout.strip())
+        if index == len(choices):
+            return self.__show_target_menu(entry, self.args.show_help)
+        return choices[index].targets, choices[index].action
