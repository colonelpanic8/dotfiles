diff --git a/system/imc/x86/amd_zen_addr.c b/system/imc/x86/amd_zen_addr.c
new file mode 100644
index 0000000..fa1662a
--- /dev/null
+++ b/system/imc/x86/amd_zen_addr.c
@@ -0,0 +1,176 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "amd_zen_addr.h"
+
+#define BIT64(n)                    (1ULL << (n))
+#define DF_ADDR_RANGE_VALID         (1U << 0)
+#define DF_LEGACY_MMIO_HOLE_ENABLED (1U << 1)
+#define DF3_INTERLEAVE_MODE_MASK    (0xFU << 2)
+#define DF3_INTERLEAVE_ADDR_MASK    (0x7U << 9)
+#define DF3_INTERLEAVE_DIES_MASK    (0x3U << 6)
+#define DF3_INTERLEAVE_SOCKET_MASK  (1U << 8)
+#define DF3_TWO_CHANNEL_HASHED      (0xCU << 2)
+#define DF3_HASH_64K                (1U << 20)
+#define DF3_HASH_2M                 (1U << 21)
+#define DF3_HASH_1G                 (1U << 22)
+#define DF_ADDR_MASK                0xFFFFF000U
+#define DF_ADDR_SHIFT               16
+#define DF_LIMIT_LOW_MASK           ((1ULL << 28) - 1)
+#define DF_HOLE_BASE_MASK           0xFF000000U
+#define DF_HOLE_VALID               (1U << 0)
+#define DF3_DESTINATION_ID_MASK     0x3FFU
+#define FOUR_GB                     (1ULL << 32)
+#define UMC_CS_ENABLED              (1U << 0)
+#define UMC_CS_COMPARE_BITS         0xFFFFFFFEU
+
+static bool same_chip_select_layout(
+    const uint32_t cs_base[AMD_ZEN_CHANNELS][AMD_ZEN_CHIP_SELECTS],
+    const uint32_t cs_mask[AMD_ZEN_CHANNELS][AMD_ZEN_CS_MASKS])
+{
+    for (int cs = 0; cs < AMD_ZEN_CHIP_SELECTS; cs++) {
+        if (cs_base[0][cs] != cs_base[1][cs]) {
+            return false;
+        }
+    }
+    for (int mask = 0; mask < AMD_ZEN_CS_MASKS; mask++) {
+        if (cs_mask[0][mask] != cs_mask[1][mask]) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool amd_zen_addr_map_init(amd_zen_addr_map_t *map,
+                           uint32_t dram_base,
+                           uint32_t dram_limit,
+                           uint32_t global_ctl,
+                           uint32_t hole_ctl,
+                           const uint32_t cs_base[AMD_ZEN_CHANNELS][AMD_ZEN_CHIP_SELECTS],
+                           const uint32_t cs_mask[AMD_ZEN_CHANNELS][AMD_ZEN_CS_MASKS])
+{
+    memset(map, 0, sizeof(*map));
+
+    if (!(dram_base & DF_ADDR_RANGE_VALID)) {
+        return false;
+    }
+    if ((dram_base & DF3_INTERLEAVE_MODE_MASK) != DF3_TWO_CHANNEL_HASHED) {
+        return false;
+    }
+    if (dram_base & (DF3_INTERLEAVE_DIES_MASK | DF3_INTERLEAVE_SOCKET_MASK)) {
+        return false;
+    }
+    if (dram_limit & DF3_DESTINATION_ID_MASK) {
+        return false;
+    }
+    if (!same_chip_select_layout(cs_base, cs_mask)) {
+        return false;
+    }
+
+    uint8_t interleave_bit = 8 + ((dram_base & DF3_INTERLEAVE_ADDR_MASK) >> 9);
+    if (interleave_bit != 8 && interleave_bit != 9) {
+        return false;
+    }
+
+    map->legacy_hole_enabled = (dram_base & DF_LEGACY_MMIO_HOLE_ENABLED) != 0;
+    map->hash_64k = (global_ctl & DF3_HASH_64K) != 0;
+    map->hash_2m = (global_ctl & DF3_HASH_2M) != 0;
+    map->hash_1g = (global_ctl & DF3_HASH_1G) != 0;
+    map->interleave_bit = interleave_bit;
+    map->base_addr = (uint64_t)(dram_base & DF_ADDR_MASK) << DF_ADDR_SHIFT;
+    map->limit_addr = ((uint64_t)(dram_limit & DF_ADDR_MASK) << DF_ADDR_SHIFT) | DF_LIMIT_LOW_MASK;
+    map->hole_base = hole_ctl & DF_HOLE_BASE_MASK;
+
+    if (map->base_addr > map->limit_addr) {
+        return false;
+    }
+    if (map->legacy_hole_enabled
+        && (!(hole_ctl & DF_HOLE_VALID) || map->hole_base == 0 || map->hole_base >= FOUR_GB)) {
+        return false;
+    }
+
+    memcpy(map->cs_base, cs_base, sizeof(map->cs_base));
+    memcpy(map->cs_mask, cs_mask, sizeof(map->cs_mask));
+    map->valid = true;
+    return true;
+}
+
+static uint8_t decode_channel(const amd_zen_addr_map_t *map, uint64_t addr)
+{
+    uint8_t channel = (addr >> map->interleave_bit) & 1;
+
+    channel ^= (addr >> 14) & 1;
+    if (map->hash_64k) {
+        channel ^= (addr >> 18) & 1;
+    }
+    if (map->hash_2m) {
+        channel ^= (addr >> 23) & 1;
+    }
+    if (map->hash_1g) {
+        channel ^= (addr >> 32) & 1;
+    }
+    return channel;
+}
+
+static uint64_t remove_bit(uint64_t value, uint8_t bit)
+{
+    uint64_t low_mask = BIT64(bit) - 1;
+    return (value & low_mask) | ((value >> 1) & ~low_mask);
+}
+
+bool amd_zen_decode_dimm(const amd_zen_addr_map_t *map,
+                         uint64_t system_addr,
+                         amd_zen_dimm_location_t *location)
+{
+    if (!map->valid || system_addr < map->base_addr || system_addr > map->limit_addr) {
+        return false;
+    }
+
+    uint8_t channel = decode_channel(map, system_addr);
+
+    uint64_t unhashed_addr = system_addr;
+    uint8_t encoded_channel = (unhashed_addr >> map->interleave_bit) & 1;
+    if (encoded_channel != channel) {
+        unhashed_addr ^= BIT64(map->interleave_bit);
+    }
+
+    if (map->legacy_hole_enabled && unhashed_addr >= FOUR_GB) {
+        unhashed_addr -= FOUR_GB - map->hole_base;
+    }
+    if (unhashed_addr < map->base_addr) {
+        return false;
+    }
+
+    uint64_t normalized_addr = remove_bit(unhashed_addr - map->base_addr, map->interleave_bit);
+    uint32_t normalized_reg_addr = normalized_addr >> 8;
+    int matched_cs = -1;
+
+    for (int cs = 0; cs < AMD_ZEN_CHIP_SELECTS; cs++) {
+        uint32_t base = map->cs_base[channel][cs];
+        if (!(base & UMC_CS_ENABLED)) {
+            continue;
+        }
+
+        uint32_t mask = map->cs_mask[channel][cs >> 1];
+        uint32_t compare_bits = ~mask & UMC_CS_COMPARE_BITS;
+        if ((normalized_reg_addr & compare_bits) == (base & compare_bits)) {
+            if (matched_cs >= 0) {
+                return false;
+            }
+            matched_cs = cs;
+        }
+    }
+
+    if (matched_cs < 0) {
+        return false;
+    }
+
+    location->channel = channel;
+    location->dimm = matched_cs >> 1;
+    location->rank = matched_cs & 1;
+    location->normalized_addr = normalized_addr;
+    return true;
+}
