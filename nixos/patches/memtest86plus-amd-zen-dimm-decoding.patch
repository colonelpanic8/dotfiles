+#define AMD_DF_FICAA_REG            0x5C
+#define AMD_DF_FICAD_REG            0x98
+#define AMD_DF_INSTANCE_ENABLE      (1U << 0)
+#define AMD_DF_INSTANCE_SHIFT       16
+#define AMD_DF_FUNCTION_SHIFT       11
+#define AMD_DF_REGISTER_MASK        0x7FC
+#define AMD_DF_DEVICE               0x18
+#define AMD_DF_FUNCTION             4
+#define AMD_DF_DRAM_BASE            0x110
+#define AMD_DF_DRAM_LIMIT           0x114
+#define AMD_DF_DRAM_HOLE            0x104
+#define AMD_DF_GLOBAL_CTL           0x3F8
+
+#define AMD_SMN_UMC_CS_BASE         (AMD_SMN_UMC_BAR + 0x00)
+#define AMD_SMN_UMC_CS_BASE_SEC     (AMD_SMN_UMC_BAR + 0x10)
+#define AMD_SMN_UMC_CS_MASK         (AMD_SMN_UMC_BAR + 0x20)
+#define AMD_SMN_UMC_CS_MASK_SEC     (AMD_SMN_UMC_BAR + 0x28)
+
+static amd_zen_addr_map_t amd_zen_addr_map;
+
+static uint32_t amd_df_read(uint8_t instance, uint8_t function, uint16_t reg)
+{
+    uint32_t ficaa = AMD_DF_INSTANCE_ENABLE;
+
+    ficaa |= (uint32_t)instance << AMD_DF_INSTANCE_SHIFT;
+    ficaa |= (uint32_t)function << AMD_DF_FUNCTION_SHIFT;
+    ficaa |= reg & AMD_DF_REGISTER_MASK;
+
+    pci_config_write32(0, AMD_DF_DEVICE, AMD_DF_FUNCTION, AMD_DF_FICAA_REG, ficaa);
+    return pci_config_read32(0, AMD_DF_DEVICE, AMD_DF_FUNCTION, AMD_DF_FICAD_REG);
+}
+
+static uint32_t amd_df_read_broadcast(uint8_t function, uint16_t reg)
+{
+    uint32_t ficaa = (uint32_t)function << AMD_DF_FUNCTION_SHIFT;
+    ficaa |= reg & AMD_DF_REGISTER_MASK;
+
+    pci_config_write32(0, AMD_DF_DEVICE, AMD_DF_FUNCTION, AMD_DF_FICAA_REG, ficaa);
+    return pci_config_read32(0, AMD_DF_DEVICE, AMD_DF_FUNCTION, AMD_DF_FICAD_REG);
+}
+
+static void init_dimm_decoder_amd_zen(void)
+{
+    uint32_t cs_base[AMD_ZEN_CHANNELS][AMD_ZEN_CHIP_SELECTS];
+    uint32_t cs_mask[AMD_ZEN_CHANNELS][AMD_ZEN_CS_MASKS];
+    uint32_t dram_base = amd_df_read(0, 0, AMD_DF_DRAM_BASE);
+    uint32_t dram_limit = amd_df_read(0, 0, AMD_DF_DRAM_LIMIT);
+    uint32_t global_ctl = amd_df_read_broadcast(0, AMD_DF_GLOBAL_CTL);
+    uint32_t hole_ctl = amd_df_read_broadcast(0, AMD_DF_DRAM_HOLE);
+
+    if (dram_base != amd_df_read(1, 0, AMD_DF_DRAM_BASE)
+        || dram_limit != amd_df_read(1, 0, AMD_DF_DRAM_LIMIT)) {
+        return;
+    }
+
+    for (int channel = 0; channel < AMD_ZEN_CHANNELS; channel++) {
+        uint32_t channel_offset = channel * AMD_SMN_UMC_CHB_OFFSET;
+
+        for (int cs = 0; cs < AMD_ZEN_CHIP_SELECTS; cs++) {
+            cs_base[channel][cs] = amd_smn_read(AMD_SMN_UMC_CS_BASE + channel_offset + cs * 4);
+            if (amd_smn_read(AMD_SMN_UMC_CS_BASE_SEC + channel_offset + cs * 4) != 0) {
+                return;
+            }
+        }
+        for (int mask = 0; mask < AMD_ZEN_CS_MASKS; mask++) {
+            cs_mask[channel][mask] = amd_smn_read(AMD_SMN_UMC_CS_MASK + channel_offset + mask * 4);
+            if (amd_smn_read(AMD_SMN_UMC_CS_MASK_SEC + channel_offset + mask * 4) != 0) {
+                return;
+            }
+        }
+    }
+
+    amd_zen_addr_map_init(&amd_zen_addr_map, dram_base, dram_limit, global_ctl, hole_ctl,
+                          cs_base, cs_mask);
+}
