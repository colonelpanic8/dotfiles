{
  "id": "orgAgenda",
  "name": "Org agenda",
  "description": "Today's org agenda from org-agenda-api, with completion and capture through any capture template",
  "version": "1.1.0",
  "author": "Ivan Malison",
  "type": "composite",
  "capabilities": ["dankbar-widget", "desktop-widget", "dash-card"],
  "components": {
    "widget": "./OrgAgendaWidget.qml",
    "desktop": "./OrgAgendaDesktop.qml",
    "dashCard": "./OrgAgendaCard.qml"
  },
  "icon": "checklist",
  "permissions": ["process"],
  "dash": {
    "card": {
      "title": "Agenda",
      "w": 3,
      "h": 3,
      "minW": 2,
      "minH": 2
    },
    "options": [
      {
        "key": "habits",
        "text": "Show habits",
        "type": "toggle",
        "def": false
      }
    ]
  }
}
