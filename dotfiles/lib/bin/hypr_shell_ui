#!/usr/bin/env bash
set -euo pipefail

if [[ -x /run/current-system/sw/bin/desktop_shell_ui ]]; then
  shell_ui="$(/run/current-system/sw/bin/desktop_shell_ui current 2>/dev/null || true)"
elif command -v desktop_shell_ui >/dev/null 2>&1; then
  shell_ui="$(desktop_shell_ui current 2>/dev/null || true)"
else
  shell_ui=""
fi

shell_ui="${shell_ui:-${IM_HYPRLAND_SHELL_UI:-taffybar}}"

run_launcher() {
  case "$shell_ui" in
    taffybar|rofi)
      exec rofi -show drun -show-icons
      ;;
    dms)
      exec dms ipc call spotlight toggle
      ;;
    noctalia)
      exec noctalia msg panel-toggle launcher
      ;;
    *)
      echo "unknown IM_HYPRLAND_SHELL_UI: $shell_ui" >&2
      exit 2
      ;;
  esac
}

run_window_picker() {
  local mode="${1:-}"

  case "$mode" in
    go|bring|replace) ;;
    *)
      echo "usage: hypr_shell_ui window {go|bring|replace}" >&2
      exit 2
      ;;
  esac

  exec hypr_rofi_window "$mode"
}

case "${1:-}" in
  launcher)
    run_launcher
    ;;
  run)
    case "$shell_ui" in
      dms) exec dms ipc call spotlight toggle ;;
      noctalia) exec noctalia msg panel-toggle launcher ;;
      *) exec rofi -show run ;;
    esac
    ;;
  control-center)
    case "$shell_ui" in
      dms) exec dms ipc call control-center toggle ;;
      noctalia) exec noctalia msg panel-toggle control-center home ;;
      *) exit 0 ;;
    esac
    ;;
  settings)
    case "$shell_ui" in
      dms) exec dms ipc call settings focusOrToggle ;;
      noctalia) exec noctalia msg settings-toggle ;;
      *) exit 0 ;;
    esac
    ;;
  window)
    shift
    run_window_picker "$@"
    ;;
  *)
    echo "usage: hypr_shell_ui {launcher|run|control-center|settings|window}" >&2
    exit 2
    ;;
esac
