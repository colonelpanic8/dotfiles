#!/usr/bin/env bash
set -euo pipefail

state_file="${IM_DESKTOP_SHELL_UI_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/imalison/desktop-shell-ui}"
default_shell_ui="${IM_HYPRLAND_SHELL_UI:-taffybar}"

normalize_shell_ui() {
  case "${1:-}" in
    taffybar|rofi)
      printf '%s\n' "taffybar"
      ;;
    dms|noctalia)
      printf '%s\n' "$1"
      ;;
    *)
      return 1
      ;;
  esac
}

current_shell_ui() {
  local configured=""

  if [[ -r "$state_file" ]]; then
    IFS= read -r configured < "$state_file" || true
  fi

  normalize_shell_ui "$configured" 2>/dev/null \
    || normalize_shell_ui "$default_shell_ui" 2>/dev/null \
    || printf '%s\n' "taffybar"
}

write_shell_ui() {
  local shell_ui="$1"
  mkdir -p "$(dirname "$state_file")"
  printf '%s\n' "$shell_ui" > "$state_file"
}

reset_stopped_units() {
  systemctl --user reset-failed "$@" 2>/dev/null || true
}

start_modular_sni_watcher() {
  systemctl --user start status-notifier-watcher.service
}

stop_conflicting_sni_watchers() {
  local cmdline=""
  local owner_pid=""
  local owner_unit=""

  systemctl --user stop status-notifier-watcher.service 2>/dev/null || true

  owner_pid="$(
    { busctl --user status org.kde.StatusNotifierWatcher 2>/dev/null || true; } |
      while IFS='=' read -r key value; do
        if [[ "$key" == PID ]]; then
          printf '%s' "$value"
          break
        fi
      done
  )"

  if [[ -n "$owner_pid" ]]; then
    cmdline="$(tr '\0' ' ' < "/proc/$owner_pid/cmdline" 2>/dev/null || true)"
    if [[ "$cmdline" == *kded6* ]]; then
      IFS= read -r owner_unit < "/proc/$owner_pid/cgroup" || true
      owner_unit="${owner_unit#*::}"
      owner_unit="${owner_unit##*/}"
      if [[ -n "$owner_unit" ]]; then
        systemctl --user kill --signal=SIGKILL --kill-whom=all "$owner_unit" 2>/dev/null || true
      fi
    fi
  fi

  for _ in {1..30}; do
    if ! busctl --user status org.kde.StatusNotifierWatcher >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done
}

apply_shell_ui() {
  local shell_ui="$1"

  export IM_HYPRLAND_SHELL_UI="$shell_ui"
  systemctl --user import-environment IM_HYPRLAND_SHELL_UI 2>/dev/null || true

  case "$shell_ui" in
    taffybar)
      systemctl --user stop dms.service noctalia.service 2>/dev/null || true
      reset_stopped_units dms.service noctalia.service
      start_modular_sni_watcher
      systemctl --user start dunst.service
      systemctl --user start taffybar.service
      ;;
    dms)
      systemctl --user stop taffybar.service noctalia.service dunst.service 2>/dev/null || true
      reset_stopped_units taffybar.service noctalia.service dunst.service
      start_modular_sni_watcher
      systemctl --user start dms.service
      ;;
    noctalia)
      systemctl --user stop taffybar.service dms.service dunst.service 2>/dev/null || true
      reset_stopped_units taffybar.service dms.service dunst.service
      stop_conflicting_sni_watchers
      systemctl --user start noctalia.service
      ;;
  esac
}

set_shell_ui() {
  local shell_ui
  shell_ui="$(normalize_shell_ui "${1:-}")" || {
    echo "usage: desktop_shell_ui set {taffybar|dms|noctalia}" >&2
    exit 2
  }

  write_shell_ui "$shell_ui"
  apply_shell_ui "$shell_ui"
}

case "${1:-current}" in
  current)
    current_shell_ui
    ;;
  set)
    set_shell_ui "${2:-}"
    ;;
  toggle)
    case "$(current_shell_ui)" in
      taffybar) set_shell_ui dms ;;
      dms) set_shell_ui noctalia ;;
      noctalia) set_shell_ui taffybar ;;
    esac
    ;;
  apply)
    apply_shell_ui "$(current_shell_ui)"
    ;;
  exec-condition)
    [[ "$(current_shell_ui)" == "$(normalize_shell_ui "${2:-}")" ]]
    ;;
  exec-condition-except)
    [[ "$(current_shell_ui)" != "$(normalize_shell_ui "${2:-}")" ]]
    ;;
  *)
    echo "usage: desktop_shell_ui {current|set {taffybar|dms|noctalia}|toggle|apply|exec-condition|exec-condition-except}" >&2
    exit 2
    ;;
esac
