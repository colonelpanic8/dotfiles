#!/usr/bin/env bash
# Print the org-agenda-api password. Prefers the agenix secret (an
# AUTH_PASSWORD=... env file, always available once agenix has run) and falls
# back to pass, which needs an unlocked gpg-agent.
set -uo pipefail

secret="${MOVA_API_PASSWORD_FILE:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/agenix/org-api-auth-password}"
if [[ -r "$secret" ]]; then
  password="$(sed -n 's/^AUTH_PASSWORD=//p' "$secret")"
  if [[ -n "$password" ]]; then
    printf '%s\n' "$password"
    exit 0
  fi
fi
pass show "${MOVA_API_PASS_ENTRY:-org-agenda-api.duckdns.org/imalison}" 2>/dev/null | head -1
