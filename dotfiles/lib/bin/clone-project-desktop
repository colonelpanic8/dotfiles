#!/usr/bin/env zsh

function clone_project_desktop {
  emulate -L zsh
  setopt errexit nounset pipefail

  local picker_mode="repositories"

  function usage {
    cat <<'EOF'
Usage: clone-project-desktop [QUERY]
       clone-project-desktop --user [OWNER-QUERY]

Open clone-project's interactive GitHub repository picker in a dedicated
graphical terminal window. All searching, selection, cloning, validation, and
completion reporting remain in clone-project.

Environment:
  CLONE_PROJECT_TERMINAL  Graphical terminal command
                          (default: ghostty)
EOF
  }

  case "${1:-}" in
    -h|--help)
      usage
      return 0
      ;;
    --user)
      picker_mode="owners"
      shift
      (( $# <= 1 )) || {
        usage >&2
        return 2
      }
      ;;
    *)
      (( $# <= 1 )) || {
        usage >&2
        return 2
      }
      ;;
  esac

  local clone_project_command script_dir terminal
  typeset -a terminal_argv clone_argv

  script_dir="${functions_source[clone_project_desktop]:A:h}"
  clone_project_command="$script_dir/clone-project"
  terminal="${CLONE_PROJECT_TERMINAL:-ghostty}"
  terminal_argv=(${(z)terminal})
  if (( ${#terminal_argv[@]} == 0 )) || ! command -v "${terminal_argv[1]}" >/dev/null 2>&1; then
    print -u2 -- "clone-project-desktop: graphical terminal not found: ${terminal_argv[1]:-$terminal}"
    return 127
  fi
  if [[ ! -x "$clone_project_command" ]]; then
    print -u2 -- "clone-project-desktop: clone-project is not executable next to the launcher"
    return 127
  fi

  clone_argv=("$clone_project_command")
  if [[ "$picker_mode" == "owners" ]]; then
    clone_argv+=(--user)
  else
    clone_argv+=(--search)
  fi
  (( $# == 0 )) || clone_argv+=("$1")

  # Give Ghostty launches their own identity so the window manager can treat
  # this as a compact picker instead of another ordinary terminal.
  if [[ "${terminal_argv[1]:t}" == "ghostty" ]]; then
    terminal_argv+=(
      --gtk-single-instance=false
      --class=com.mitchellh.ghostty.githubclone
      '--title=GitHub Clone'
      --window-width=120
      --window-height=32
    )
  fi

  (
    CLONE_PROJECT_DESKTOP_LAUNCHED=1 \
      "${terminal_argv[@]}" -e "${clone_argv[@]}" >/dev/null 2>&1 &!
  )
}

clone_project_desktop "$@"
