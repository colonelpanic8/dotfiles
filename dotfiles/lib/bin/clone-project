#!/usr/bin/env bash

set -euo pipefail

projects_dir="${PROJECTS_DIR:-$HOME/Projects}"
github_mode=false

usage() {
  cat <<'EOF'
Usage: clone-project [--github] [REPOSITORY [DIRECTORY]]

Clone a git repository into ~/Projects. With no REPOSITORY, prompt for it on
the terminal, so this works over SSH or any other non-graphical session.
DIRECTORY, when provided, must be a single directory name.

With --github, REPOSITORY is an OWNER/REPO name and cloning is delegated to
`gh repo clone`, honoring the authenticated GitHub CLI account and configured
git protocol.

Set PROJECTS_DIR to use a different project root.

For a graphical rofi + desktop-notification launcher, see
clone-project-desktop.
EOF
}

infer_project_name() {
  local repository="$1"
  local name

  repository="${repository%/}"
  repository="${repository%%\?*}"
  repository="${repository%%\#*}"
  name="${repository##*/}"
  name="${name##*:}"
  name="${name%.git}"

  if [[ -z "$name" || "$name" == "." || "$name" == ".." || "$name" == */* ]]; then
    return 1
  fi

  printf '%s\n' "$name"
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  --github)
    github_mode=true
    shift
    ;;
esac

if (( $# == 0 )); then
  if $github_mode; then
    usage >&2
    exit 2
  fi

  if [[ ! -t 0 ]]; then
    printf 'clone-project: no REPOSITORY given and stdin is not a terminal\n' >&2
    exit 2
  fi

  read -rp "Clone into ${projects_dir/#$HOME/~}: " repository
  [[ -n "$repository" ]] || exit 0
elif (( $# <= 2 )); then
  repository="$1"
else
  usage >&2
  exit 2
fi

if (( $# == 2 )); then
  project_name="$2"
  if [[ -z "$project_name" || "$project_name" == "." || "$project_name" == ".." || "$project_name" == */* ]]; then
    printf 'clone-project: DIRECTORY must be a single directory name\n' >&2
    exit 2
  fi
elif ! project_name="$(infer_project_name "$repository")"; then
  printf 'clone-project: could not infer a directory name; pass one as the second argument\n' >&2
  exit 2
fi

case "$projects_dir" in
  "~") projects_dir="$HOME" ;;
  \~/*) projects_dir="$HOME/${projects_dir#\~/}" ;;
esac

destination="$projects_dir/$project_name"

if [[ -e "$destination" ]]; then
  printf 'clone-project: destination already exists: %s\n' "$destination" >&2
  exit 1
fi

if ! mkdir -p -- "$projects_dir"; then
  printf 'clone-project: could not create project directory: %s\n' "$projects_dir" >&2
  exit 1
fi

cd -- "$projects_dir"

if $github_mode; then
  if ! command -v gh >/dev/null 2>&1; then
    printf 'clone-project: gh is required with --github\n' >&2
    exit 127
  fi
  gh repo clone "$repository" "$project_name" -- --recurse-submodules --progress
else
  git clone --recurse-submodules --progress -- "$repository" "$project_name"
fi

printf 'Cloned to %s\n' "$destination"
