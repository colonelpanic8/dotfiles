#!/usr/bin/env python3
"""Log in at the physical seat by driving greetd's IPC socket directly.

The Dux/DMS greeter is just a greetd client, so anything that can reach
greetd's socket can authenticate a user and start their session. Once the
session is scheduled greetd gives the running greeter 5 seconds to exit before
killing it, then launches the session on the greeter's VTY.

Works over SSH: `greeter-login [user]`. Re-runs itself under sudo, because the
socket belongs to the greeter user. Passwords are read from the terminal, or
with --pass-entry from `pass` and handed over on stdin; never from argv.
"""
import argparse
import configparser
import getpass
import glob
import json
import os
import socket
import struct
import subprocess
import sys

SESSION_DIRS = [
    "/run/current-system/sw/share/wayland-sessions",
    "/usr/share/wayland-sessions",
]
# The greeter's normal choice; plain "hyprland" skips uwsm, so the session target and DMS never start.
DEFAULT_SESSION = "hyprland-uwsm"


def find_socket():
    if os.environ.get("GREETD_SOCK"):
        return os.environ["GREETD_SOCK"]
    try:
        pid = subprocess.run(
            ["systemctl", "show", "--value", "-p", "MainPID", "greetd.service"],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        pid = ""
    if pid and pid != "0" and os.path.exists(f"/run/greetd-{pid}.sock"):
        return f"/run/greetd-{pid}.sock"
    socks = glob.glob("/run/greetd-*.sock")
    if len(socks) == 1:
        return socks[0]
    sys.exit("greeter-login: could not find greetd's socket; is the greeter running?")


def load_sessions():
    sessions = {}
    for directory in SESSION_DIRS:
        for path in sorted(glob.glob(os.path.join(directory, "*.desktop"))):
            session_id = os.path.basename(path)[: -len(".desktop")]
            if session_id in sessions:
                continue
            parser = configparser.ConfigParser(interpolation=None, strict=False)
            parser.optionxform = str
            try:
                parser.read(path)
                entry = parser["Desktop Entry"]
            except (configparser.Error, KeyError):
                continue
            if entry.get("Hidden") == "true" or entry.get("NoDisplay") == "true":
                continue
            if "Exec" not in entry:
                continue
            sessions[session_id] = {
                "name": entry.get("Name", session_id),
                "exec": entry["Exec"],
                "desktop_names": entry.get("DesktopNames", ""),
            }
    return sessions


def session_env(session_id, desktop_names):
    # Mirrors sessionLaunchEnv() in the greeter's GreeterContent.qml.
    env = ["XDG_SESSION_TYPE=wayland"]
    if session_id:
        env += [f"XDG_SESSION_DESKTOP={session_id}", f"DESKTOP_SESSION={session_id}"]
    current = desktop_names.replace(";", ":").strip(":")
    if current:
        env.append(f"XDG_CURRENT_DESKTOP={current}")
    return env


class Greetd:
    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(path)

    def _recv_exact(self, n):
        data = b""
        while len(data) < n:
            chunk = self.sock.recv(n - len(data))
            if not chunk:
                raise ConnectionError("greetd closed the connection")
            data += chunk
        return data

    def request(self, msg_type, **fields):
        payload = json.dumps({"type": msg_type, **fields}).encode()
        self.sock.sendall(struct.pack("=I", len(payload)) + payload)
        (length,) = struct.unpack("=I", self._recv_exact(4))
        return json.loads(self._recv_exact(length))


def authenticate(greetd, user, secret=None):
    reply = greetd.request("create_session", username=user)
    while reply["type"] == "auth_message":
        kind, text = reply["auth_message_type"], reply["auth_message"]
        if kind == "secret" and secret is not None:
            response = secret
        elif kind == "secret":
            response = getpass.getpass(text if text.endswith(" ") else text + " ")
        elif kind == "visible":
            response = input(text if text.endswith(" ") else text + " ")
        else:
            print(text, file=sys.stderr if kind == "error" else sys.stdout)
            response = None
        reply = greetd.request("post_auth_message_response", response=response)
    if reply["type"] == "error":
        greetd.request("cancel_session")
        sys.exit(f"greeter-login: {reply['error_type']}: {reply['description']}")


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("user", nargs="?", default=os.environ.get("SUDO_USER") or getpass.getuser())
    parser.add_argument("-s", "--session", default=DEFAULT_SESSION,
                        help=f"wayland session id (default: {DEFAULT_SESSION})")
    parser.add_argument("-l", "--list-sessions", action="store_true")
    parser.add_argument("--pass-entry", metavar="ENTRY",
                        help="answer the password prompt with the first line of this pass entry")
    parser.add_argument("--password-stdin", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()

    sessions = load_sessions()
    if args.list_sessions:
        for session_id, session in sessions.items():
            print(f"{session_id}\t{session['name']}")
        return
    if args.session not in sessions:
        sys.exit(f"greeter-login: unknown session {args.session!r}; try --list-sessions")

    if os.geteuid() != 0:
        # The PATH sudo is not setuid inside sandboxed agent shells.
        sudo = "/run/wrappers/bin/sudo" if os.path.exists("/run/wrappers/bin/sudo") else "sudo"
        cmd = [sudo, "--", sys.executable, os.path.abspath(__file__), args.user, "--session", args.session]
        if not args.pass_entry:
            os.execvp(sudo, cmd)
        secret = subprocess.run(["pass", "show", args.pass_entry], capture_output=True,
                                text=True, check=True).stdout.split("\n", 1)[0]
        sys.exit(subprocess.run(cmd + ["--password-stdin"], input=secret + "\n", text=True, check=False).returncode)

    session = sessions[args.session]
    greetd = Greetd(find_socket())
    # Drop anything the greeter UI left half-configured (e.g. a pending
    # fingerprint prompt); greetd only allows one configuring session.
    greetd.request("cancel_session")
    authenticate(greetd, args.user, sys.stdin.readline().rstrip("\n") if args.password_stdin else None)
    reply = greetd.request(
        "start_session",
        cmd=session["exec"].split(),
        env=session_env(args.session, session["desktop_names"]),
    )
    if reply["type"] == "error":
        greetd.request("cancel_session")
        sys.exit(f"greeter-login: {reply['error_type']}: {reply['description']}")
    print(f"Starting {session['name']} for {args.user}; the greeter will exit shortly.")


if __name__ == "__main__":
    main()
