#!/usr/bin/env bash
set -euo pipefail

# Clicks an entry in CrossPaste's tray menu. CrossPaste refuses a second
# instance and has no CLI command for its windows, so the menu is the only
# way to raise them.
label="${1:-Open search window}"

find_crosspaste_item() {
    local service

    while IFS= read -r service; do
        if busctl --user --timeout=3s get-property "$service" /StatusNotifierItem org.kde.StatusNotifierItem Title 2>/dev/null \
            | grep -qx 's "CrossPaste"'; then
            printf '%s\n' "$service"
            return 0
        fi
    done < <(busctl --user list --no-legend 2>/dev/null | awk '$1 ~ /^org\.kde\.StatusNotifierItem-/ { print $1 }')

    return 1
}

menu_item_id() {
    CROSSPASTE_MENU_LABEL="$label" CROSSPASTE_DBUSMENU_LAYOUT="$(cat)" python3 - <<'PY'
import os
import re

label = re.escape(os.environ["CROSSPASTE_MENU_LABEL"])
layout = os.environ.get("CROSSPASTE_DBUSMENU_LAYOUT", "")
for record in layout.split("(ia{sv}av)")[1:]:
    item_id = re.match(r"\s+([0-9]+)\s+", record)
    if item_id and re.search(r'"label"\s+s\s+"' + label + r'"(?:\s|$)', record):
        print(item_id.group(1))
        break
PY
}

service="$(find_crosspaste_item || true)"
if [ -z "$service" ]; then
    systemctl --user start crosspaste.service >/dev/null 2>&1 || true
    for _ in $(seq 1 100); do
        service="$(find_crosspaste_item || true)"
        [ -n "$service" ] && break
        sleep 0.1
    done
fi
[ -n "$service" ] || exit 1

menu_path="$(busctl --user --timeout=3s get-property "$service" /StatusNotifierItem org.kde.StatusNotifierItem Menu \
    | awk '$1 == "o" { gsub(/"/, "", $2); print $2; exit }')"
item_id="$(busctl --user --timeout=3s call "$service" "$menu_path" com.canonical.dbusmenu GetLayout iias 0 -- -1 0 \
    | menu_item_id)"
[ -n "$item_id" ] || exit 1

busctl --user --timeout=3s call "$service" "$menu_path" com.canonical.dbusmenu Event isvu \
    "$item_id" clicked v i 0 0 >/dev/null
